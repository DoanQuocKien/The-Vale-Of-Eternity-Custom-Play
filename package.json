{
  "name": "vale-of-eternity-custom-designer",
  "productName": "The Vale of Eternity: Card Creator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "vite build && electron .",
    "electron:build": "vite build && electron-builder --win"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@tensorflow/tfjs": "^4.22.0",
    "@upscalerjs/esrgan-medium": "^1.0.0",
    "html2canvas": "^1.4.1",
    "jscanify": "^1.4.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.395.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "upscaler": "^1.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^35.7.5",
    "electron-builder": "^25.1.8",
    "vite": "^5.3.1"
  },
  "build": {
    "appId": "com.valeeternity.cardcreator",
    "productName": "The Vale of Eternity - Card Creator",
    "copyright": "Copyright © 2024",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "public",
        "to": "public",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/img/TextIcon/Score.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Vale of Eternity Card Creator"
    },
    "directories": {
      "output": "release"
    }
  }
}
