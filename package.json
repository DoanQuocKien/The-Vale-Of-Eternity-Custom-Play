{
  "name": "vale-of-eternity-custom-designer",
  "productName": "The Vale of Eternity - Card Creator",
  "description": "Design, customize, and export custom creature cards for The Vale of Eternity.",
  "author": "Doan Quoc Kien",
  "private": true,
  "version": "1.3.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "neu:dev": "concurrently \"vite\" \"npx neu run -- --url=http://127.0.0.1:3000\"",
    "neu:build": "vite build && npx neu build",
    "neu:release": "vite build && npx neu build --release"
  },
  "dependencies": {
    "@neutralinojs/lib": "^3.12.0",
    "html2canvas": "^1.4.1",
    "jscanify": "^1.4.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.395.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@neutralinojs/neu": "^11.1.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^10.0.3",
    "vite": "^5.3.1",
    "vite-plugin-node-polyfills": "^0.28.0"
  }
}
