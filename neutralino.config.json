{
  "applicationId": "js.neutralino.valeofeternity",
  "version": "1.4.2",
  "defaultMode": "window",
  "documentRoot": "/web-dist/",
  "port": 8008,
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "none",
  "logging": {
    "enabled": true,
    "writeToLogFile": true
  },
  "modes": {
    "window": {
      "title": "The Vale of Eternity - Card Creator",
      "width": 1280,
      "height": 800,
      "minWidth": 1024,
      "minHeight": 720,
      "icon": "/img/icon.png",
      "enableInspector": false,
      "borderless": false,
      "maximize": false,
      "hidden": false,
      "resizable": true,
      "alwaysOnTop": false
    }
  },
  "cli": {
    "binaryName": "vale-of-eternity",
    "resourcesPath": "/web-dist",
    "extensionsPath": "/extensions",
    "clientLibrary": "/neutralino.js",
    "binaryVersion": "4.15.0",
    "clientVersion": "3.12.0",
    "frontendLibrary": {
      "patchFile": "/index.html",
      "devUrl": "http://127.0.0.1:3000",
      "projectPath": "/",
      "buildCommand": "npm run build"
    },
    "distributionPath": "/dist"
  }
}
